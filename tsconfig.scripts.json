{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode: the extractor imports donor TS through extensionless and
       index paths, which nodenext resolution would reject. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* The dp-800 donor's deep modules import their own types through the
       `@/` alias (type-only, so tsx erases them); this mapping lets tsc
       resolve those imports when the extractor pulls the files into this
       program. It points into the read-only submodule — never edit donor
       files to work around it. */
    "paths": { "@/*": ["./learn-dp-800/src/*"] },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scripts"]
}
